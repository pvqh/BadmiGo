# Copy to .env. Expo inlines anything prefixed EXPO_PUBLIC_ into the app bundle, so
# only public values belong here: the anon key is public by design and row-level
# security is what protects the data. The service role key and the VAPID private key
# must never appear in this file.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-from-supabase-status
# The public half of the Web Push key pair in supabase/functions/.env.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=paste-the-vapid-public-key
