# Copy to supabase/functions/.env; the local Edge Functions read it. In production
# the same three are set with `npx supabase secrets set`. Never commit the filled copy.
#
# Generate a key pair once (the manual shows the command) and put the public half in
# the root .env as EXPO_PUBLIC_VAPID_PUBLIC_KEY too. Changing the pair later turns
# off notifications on every phone until each member switches them on again.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=paste-the-public-key
VAPID_PRIVATE_KEY=paste-the-private-key
